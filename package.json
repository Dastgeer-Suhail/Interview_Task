{
  "name": "mern-task-manager",
  "version": "1.0.0",
  "description": "Full-stack MERN Task Manager application with MongoDB, Express, React, and Node.js",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["mern", "react", "express", "mongodb", "nodejs", "task-manager"],
  "author": "",
  "license": "ISC"
}
